# LifePath Docker - uncommon ports to avoid local collisions (39173 web, 39081 API)
# Copy to .env and customize as needed.

POSTGRES_PASSWORD=lifepath

# Google Calendar OAuth (create credentials in Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Override when the app is reachable at a non-localhost URL (LAN, VPN, etc.)
# APP_FRONTEND_URL=http://your-host:39173
# GOOGLE_REDIRECT_URI=http://your-host:39081/api/v1/calendar/callback
